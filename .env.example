# TMDB — optional, a built-in read access token is provided by default
# TMDB_API_TOKEN=your_own_tmdb_read_access_token
# Cookie security - set to 'true' in production behind reverse proxy

# ── Secrets ────────────────────────────────────────────────────────────────
# All three are refused at boot when left empty, kept at a placeholder, or too short.
# LeMedia prints a ready-to-paste value in that case, so a wrong guess costs one restart.
#
#   LEMEDIA_SECRET_KEY  openssl rand -hex 32       (encrypts stored service credentials)
#   JWT_SECRET         openssl rand -base64 32    (signs sessions — changing it signs everyone out)
#   SETUP_SECRET       openssl rand -base64 32    (guards the install wizard)
#
# LEMEDIA_SECRET_KEY is the one you must not lose: without it, stored credentials are
# unrecoverable and every service has to be reconfigured by hand.
LEMEDIA_SECRET_KEY=
JWT_SECRET=
SETUP_SECRET=

# App
PORT=3456
# Bind to loopback for local development; defaults to 0.0.0.0
# HOST=127.0.0.1
NODE_ENV=production
DATABASE_URL=file:../data/lemedia.db
FRONTEND_URL=http://localhost:5173
# COOKIE_SECURE=true
# Trust X-Forwarded-* headers. Leave true behind Docker / Traefik / nginx / Caddy. Set to false
# only when LeMedia is exposed directly (no reverse proxy), otherwise clients can spoof their IP.
# An IP/CIDR allow-list (e.g. TRUST_PROXY=127.0.0.1) or hop count also works; a malformed value
# falls back to trusting nothing with a boot warning instead of crashing startup.
# TRUST_PROXY=true
INSTALL_FILE_PATH=./data/install.json
# BACKUP_MAX_SIZE_MB=500

# Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Docker data volume and database file name (defaults: lemedia-data / lemedia.db).
# Only set these to keep using an existing volume or database under another name.
# LEMEDIA_DATA_VOLUME=lemedia-data
# LEMEDIA_DB_FILE=lemedia.db

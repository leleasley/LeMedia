generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  displayName           String?
  passwordHash          String?
  avatar                String?   // resolved/cached URL — derived from avatarSource + matching UserProvider.providerAvatar (or the dicebear data URI)
  avatarSource          String?   // null = legacy/auto, "none" = initials fallback, "dicebear" = generated, otherwise a linked provider id ("plex", "discord", ...)
  avatarConfig          String?   // JSON for the dicebear generator: { style, seed } — lets the editor restore the user's choice next time
  role                  String    @default("user") // "admin" | "user"
  disabled              Boolean   @default(false) // true = login blocked or friendly-gated depending on AppSettings.disabledLoginMode
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  providers             UserProvider[]
  requests              MediaRequest[]
  approvedRequests      MediaRequest[] @relation("ApprovedBy")
  notifications         UserNotification[]
  blacklistedMedia      BlacklistedMedia[] @relation("BlacklistCreatedBy")
  pushSubscriptions     PushSubscription[]
  issues                MediaIssue[]
  resolvedIssues        MediaIssue[]  @relation("MediaIssueResolvedBy")
  apiKeys               UserApiKey[]
  passwordResets        PasswordResetToken[]
  shareLinks            ShareLink[]
  notifyRequests        Boolean   @default(true)  // bell notifications for own requests (approved/declined/available)
  notifyDigital         Boolean   @default(true)  // bell notifications for digital release dates
  pushPrefs             String?   // phone/web push opt-outs: JSON { [type]: boolean }, missing = on
}

model UserInvite {
  id         Int       @id @default(autoincrement())
  email      String
  tokenHash  String    @unique
  role       String    @default("user")
  invitedBy  Int?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Password reset is for local accounts only — a Plex/Jellyfin/Emby/Discord user has no
/// passwordHash and must recover through their own provider. Rows are keyed by a SHA-256 of the
/// token: the raw value exists only in the email we send, so a database read cannot mint a reset.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Transactional mail transport, separate from the notification providers: those broadcast to a
/// fixed admin address, this one writes to an arbitrary user. Singleton row (id = 1).
/// `config` is an encrypted JSON blob (same AES-256-GCM path as Service.config) — never plaintext.
/// Environment variables override this row entirely when set, so a compose-only deployment never
/// has to touch the panel.
model MailConfig {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  transport String   @default("smtp") // "smtp" | "resend"
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

model UserApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String              // user-chosen label, e.g. "Doplarr", "Maintainerr"
  // sha256(plain key) — bcrypt is overkill for high-entropy tokens, sha256 lookups are constant-time enough.
  keyHash    String    @unique
  prefix     String              // first 12 chars of the plain key, kept for display ("lemedia_a3f2…")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // "admin", "user", "moderator", etc.
  permissions String   @default("[]") // JSON array of permission strings
  isDefault   Boolean  @default(false) // Assigned to new users automatically
  isSystem    Boolean  @default(false) // Cannot be deleted (admin, user)
  position    Int      @default(0) // Display order (lower = higher priority, like Discord)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserProvider {
  id                Int       @id @default(autoincrement())
  userId            Int
  provider          String    // "plex" | "email" | "discord" | "jellyfin" | ...
  providerId        String?   // External ID from the provider (plexId, discordId, etc.)
  providerToken     String?   // OAuth token for API calls
  providerUsername  String?   // Username from the provider
  providerEmail     String?   // Email from the provider (may differ from user email)
  providerAvatar    String?   // Avatar URL fetched from this provider (used by avatar source picker)
  createdAt         DateTime  @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([userId])
}

/// Outside accounts LeMedia connects to for itself (not sign-in), one row per integration —
/// e.g. "github" for reading Zurg/rex release feeds. Secrets in `config` are encrypted.
model Integration {
  id        String   @id
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

model AuthProviderSettings {
  id         Int      @id @default(autoincrement())
  provider   String   @unique  // "email" | "plex" | "jellyfin" | "emby" | "discord" | ...
  enabled    Boolean  @default(false)
  config     String   @default("{}")  // JSON blob — OAuth creds, redirect URIs, etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id                  Int       @id @default(autoincrement())
  tmdbId              Int
  tvdbId              Int?
  /// Set when an admin explicitly linked this title to a *arr series whose TVDB record carries a
  /// different TMDB id (split shows: Top Boy 2011/2019, Doctor Who, etc.). TVDB is the series
  /// authority for Sonarr, so the link outranks the TMDB mapping — sync keeps matching it even
  /// when Sonarr reports the sibling TMDB id.
  tvdbLinkedAt        DateTime?
  /// Where this row came from when it is not an *arr: "zurg" for titles discovered in Zurg's
  /// WebDAV library. Null for *arr synced rows and anything else.
  source              String?
  /// WebDAV path of the title's folder in Zurg (e.g. `/dav/__magic__/movies/Heat (1995)/`),
  /// recorded so deleting the title can remove the release from the debrid account.
  zurgPath            String?
  /// When the release landed in the debrid account, per Zurg's folder date. Separate from
  /// `availableAt` so a Zurg scan never rewrites what Radarr/Sonarr reported.
  zurgAddedAt         DateTime?
  /// JSON inventory of a series in Zurg: [{ season, episodes: number[] }]. Filled on demand.
  zurgSeasons         String?
  zurgInventoryAt     DateTime?
  mediaType           String    // "movie" | "tv"
  title               String
  overview            String?
  posterPath          String?
  backdropPath        String?
  releaseDate         String?
  digitalReleaseDate  String?   // TMDB digital release date (YYYY-MM-DD, type 4, physical fallback)
  // Notification dedupe for the digital_release_sync job (null = not sent yet).
  digitalDiscoveredNotifiedAt DateTime?
  digitalReleaseNotifiedAt    DateTime?
  voteAverage         Float?
  genres              String?   // JSON string array
  keywordIds          String?   // JSON array of TMDB keyword IDs, e.g. "[210024,818]"
  contentRating       String?   // Content rating from TMDB (e.g. "TV-MA", "18", "R")
  statusCategory      String    @default("UNAVAILABLE")
  radarrId            Int?
  sonarrId            Int?
  // Which *arr instance radarrId/sonarrId belong to — those ids are instance-local. Null =
  // unknown, callers fall back to the default instance. Loose reference, not a relation: SQLite
  // can't add a FK without rebuilding the table, and a stale id is already handled.
  serviceId           Int?
  qualityProfileId    Int?      // Quality profile ID from Radarr/Sonarr
  availableAt         DateTime? // Set when statusCategory becomes AVAILABLE
  // Last time a media-server library scan actually saw this title. Null = never seen there, which
  // is only meaningful when the admin requires library confirmation (see AppSettings).
  libraryConfirmedAt  DateTime?
  lastMissingSearchAt DateTime? // Last time a missing episode search was triggered
  lastEpisodeInfo     String?   // JSON: latest episode added (e.g. {"season":2,"episode":5,"title":"..."})
  audioLanguages      String?   // JSON array of normalized audio languages, cached when available
  subtitleLanguages   String?   // JSON array of normalized subtitle languages, cached when available
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requests            MediaRequest[]
  seasons             Season[]
  issues              MediaIssue[]

  @@unique([tmdbId, mediaType])
  @@index([tvdbId])
  @@index([availableAt])
  @@index([radarrId])
  @@index([sonarrId])
  @@index([serviceId])
  @@index([contentRating])
  @@index([statusCategory])
  @@index([statusCategory, availableAt])
}

model Season {
  id            Int       @id @default(autoincrement())
  mediaId       Int
  seasonNumber  Int
  episodeCount  Int       @default(0)
  statusCategory String   @default("UNAVAILABLE")

  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, seasonNumber])
}

model MediaRequest {
  id            Int       @id @default(autoincrement())
  mediaId       Int
  userId        Int
  status        String    @default("pending") // "pending" | "approved" | "declined" | "processing" | "available" | "failed" | "deleted"
  mediaType     String    // "movie" | "tv"
  seasons       String?   // JSON array of season numbers for TV requests, null = all seasons
  targetDmmServiceId Int? // Frozen request destination; null retains existing Radarr/Sonarr routing
  // The title was on the service's import-list exclusions when it was requested. Such requests
  // are always held for approval; approving removes the exclusion so the add can go through.
  excluded      Boolean   @default(false)
  seasonNumbering String? // Provider numbering at selection time; null = unknown legacy provenance
  rootFolder    String?   // Root folder path override
  qualityOptionId Int?    // Selected quality option
  approvedById  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy    User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  qualityOption QualityOption? @relation(fields: [qualityOptionId], references: [id], onDelete: SetNull)
  criteria      MediaRequestCriterion[]

  @@index([userId])
  @@index([mediaId])
  @@index([status])
}

/// An axis the admin defines to describe *how* a title is wanted: language, edition, source —
/// whatever this instance routes on. Quality is deliberately not one of these: it maps to a
/// Radarr/Sonarr profile, where a criterion only ever feeds a folder rule.
model RequestCriterion {
  id            Int       @id @default(autoincrement())
  name          String    @unique // "Langue"
  position      Int       @default(0)
  /// Offered as a picker on the request form. False makes it routing-only, invisible to users.
  showOnRequest Boolean   @default(true)
  createdAt     DateTime  @default(now())

  values        RequestCriterionValue[]
}

/// One choice within a criterion: "VOSTFR" under "Langue".
model RequestCriterionValue {
  id            Int       @id @default(autoincrement())
  criterionId   Int
  label         String
  position      Int       @default(0)
  createdAt     DateTime  @default(now())

  criterion     RequestCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  requests      MediaRequestCriterion[]

  @@unique([criterionId, label])
}

/// What a request asked for, one row per criterion. A join table rather than a JSON column so the
/// grids can ask "which values are already taken on these titles" in one query.
model MediaRequestCriterion {
  requestId     Int
  valueId       Int

  request       MediaRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  value         RequestCriterionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([requestId, valueId])
  @@index([valueId])
}

model AppSettings {
  id                    Int       @id @default(1)
  defaultQualityProfile Int?      // Quality profile ID from Radarr/Sonarr
  defaultMovieFolder    String?   // Default root folder for movies
  defaultTvFolder       String?   // Default root folder for TV series
  defaultAnimeFolder    String?   // Default root folder for anime
  plexMachineId         String?   // Plex server machine identifier for access verification
  lastRadarrSync        DateTime? // Last Radarr sync timestamp
  lastSonarrSync        DateTime? // Last Sonarr sync timestamp
  syncIntervalHours     Int       @default(6) // Auto-sync interval in hours
  notificationMatrix    String?
  incidentBanner        String?   // Global incident banner text (null = no banner)
  disabledLoginMode     String    @default("friendly") // "block" | "friendly" — how to reject login for User.disabled=true
  autoApproveRequests   Boolean   @default(false)
  requestsEnabled       Boolean   @default(true)
  calendarEnabled       Boolean   @default(true)
  siteName              String    @default("LeMedia")
  registrationEnabled   Boolean   @default(true)
  // Opt-in: an install that upgrades must not silently gain a new unauthenticated auth surface.
  // Also inert without a working mail transport, so defaulting it on would only produce dead links.
  passwordResetEnabled  Boolean   @default(false)
  // Which connected service decides that a title is available — its "source of truth". Defaults to
  // the *arr, which is the historical behaviour and stays a plain value here rather than a special
  // case. Split by media type because a movie lands as one file while a series imports episode by
  // episode into a library rescanned on a schedule; the lag is not comparable.
  // Only services declaring canConfirmAvailability are offered, so the picker cannot promise
  // something a connector is unable to do.
  movieAvailabilitySource String  @default("radarr")
  tvAvailabilitySource    String  @default("sonarr")
  // Presentation of the IMPORTED state. The vocabulary is closed; only its label and colour are
  // the admin's. Colour is validated against COLOR_TOKENS before use.
  importedStateLabel    String?
  importedStateColor    String?
  nsfwBlurEnabled       Boolean   @default(true)
  /// Read "recently added" from Zurg's WebDAV library as well as the *arr/media-server sync.
  /// Off by default: an *arr install already gets this from Radarr/Sonarr webhooks.
  zurgRecentEnabled     Boolean   @default(false)
  missingSearchCooldownMin Int   @default(60) // Minutes before allowing another missing search
  instanceLanguages     String    @default("[\"en\"]") // JSON array of ISO 639-1 codes, e.g. ["fr","en"]
  siteUrl               String?   // Public URL of the instance (e.g. https://lemedia.example.com) for notification links
  apiKey                String?   // API key for external access (health check, integrations)
  homepageLayout        String?   // JSON array of HomepageSection configs
  adminDashboardLayout  String?   // JSON: { version, items[{ i, x, y, w, h }] } — null = use defaults
  verboseRequestLog     Boolean   @default(false) // When true, every HTTP request is persisted to AppLog (debug only)
  customLinks           String    @default("[]") // JSON array of { id, label, url, icon, order } — admin-defined external links rendered in the user account modal
  setupChecklistDismissed Boolean @default(false)
  // When true, LeMedia attaches an `lemedia-<username>` tag to the movie/series it adds in
  // Radarr/Sonarr. When false (default) no tag is sent — keeps usernames out of the *arr UI
  // unless the admin explicitly opts in. Pre-0.8.4 installs that used to ship the hardcoded
  // `ndp-<username>` tag are NOT auto-migrated (orphan tags remain in *arr until the admin
  // clears them manually) — see patchnote_084.
  arrUserTaggingEnabled Boolean @default(false)
  updatedAt             DateTime  @updatedAt
}

/// Durable, one-off work enqueued by SQL migrations; executed after application boot.
model PostMigrationJob {
  key           String    @id // Stable migration/task identity, never reuse for different work.
  jobKey        String    // Allowlisted core scheduler handler.
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(dbgenerated("(CAST(strftime('%s', 'now') AS INTEGER) * 1000)")) // Retry deadline, or renewable lease.
  leaseToken    String?
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(dbgenerated("(CAST(strftime('%s', 'now') AS INTEGER) * 1000)"))

  @@index([completedAt, nextAttemptAt])
}

/// One DMM wanted-list import. Doubles as the scheduled job's dedupe: a backup already recorded
/// here is never sent again automatically, so a nightly run cannot re-upload the same archive.
model DmmImport {
  id            Int      @id @default(autoincrement())
  app           String   // "radarr" | "sonarr"
  backupName    String   // zip file name, or the uploaded file's name
  source        String   // "upload" | "backup" | "auto"
  found         Int      @default(0)
  added         Int      @default(0)
  alreadyWanted Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([app, backupName])
}

model CronJob {
  id              Int       @id @default(autoincrement())
  key             String    @unique // "full_sync" | "request_sync"
  label           String    // Display name
  cronExpression  String    @default("0 */6 * * *")
  enabled         Boolean   @default(true)
  pluginId        String?   // null = core/system job; non-null = owned by that plugin
  lastRunAt       DateTime?
  lastStatus      String?   // "success" | "error"
  lastDuration    Int?      // ms
  lastResult      String?   // JSON result summary
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([pluginId])
}

model Service {
  id            Int       @id @default(autoincrement())
  name          String    // Display name (e.g. "Radarr Principal", "Sonarr 4K")
  type          String    // "radarr" | "sonarr" | "qbittorrent" | etc.
  config        String    // JSON object with service-specific config
  isDefault     Boolean   @default(false)
  enabled       Boolean   @default(true)
  webhookId     Int?      // ID of the webhook registered in the service (null = webhooks disabled)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  qualityMappings QualityMapping[]
  folderRules     FolderRule[]
}

model FolderRule {
  id            Int       @id @default(autoincrement())
  name          String    // Display name (e.g. "Animes", "Documentaires Film")
  priority      Int       @default(0) // Lower = evaluated first
  mediaType     String    // "movie" | "tv"
  conditions    String    // JSON array: [{ field, operator, value }]
  folderPath    String    // Target root folder path
  seriesType    String?   // Sonarr series type override: "anime" | "standard" | "daily"
  serviceId     Int?      // Target service for this rule
  tagIds        String    @default("[]") // JSON array of tag IDs on the target service
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())

  service       Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model QualityOption {
  id            Int       @id @default(autoincrement())
  label         String    @unique // "SD", "HD", "4K", "4K HDR"
  position      Int       @default(0) // Display order
  allowedRoles  String?   // JSON array of role names, null = all roles
  approvalMode  String?   // null = inherit global, "auto" = force auto-approve, "manual" = force manual
  createdAt     DateTime  @default(now())

  mappings      QualityMapping[]
  requests      MediaRequest[]
}

model QualityMapping {
  id                  Int       @id @default(autoincrement())
  qualityOptionId     Int
  serviceId           Int
  qualityProfileId    Int       // Profile ID from Radarr/Sonarr API
  qualityProfileName  String    // Cached name for display
  createdAt           DateTime  @default(now())

  qualityOption       QualityOption @relation(fields: [qualityOptionId], references: [id], onDelete: Cascade)
  service             Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([qualityOptionId, serviceId, qualityProfileId])
}

model AppLog {
  id            Int       @id @default(autoincrement())
  level         String    // "info" | "warn" | "error"
  label         String    // Category (e.g. "Sync", "Request", "Auth")
  message       String
  createdAt     DateTime  @default(now())

  @@index([label])
  @@index([createdAt])
}

model NotificationProviderConfig {
  id         Int      @id @default(autoincrement())
  providerId String   @unique          // "discord", "telegram", "email", "plugin:slack", etc.
  enabled    Boolean  @default(false)
  settings   String   @default("{}")   // JSON blob: { "webhookUrl": "...", "botToken": "..." }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BlacklistedMedia {
  id            Int       @id @default(autoincrement())
  tmdbId        Int
  mediaType     String    // "movie" | "tv"
  title         String    // Display name for admin reference
  posterPath    String?   // TMDB poster path for display
  reason        String?   // Optional reason
  createdById   Int?
  createdAt     DateTime  @default(now())

  createdBy     User?     @relation("BlacklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tmdbId, mediaType])
}

model TmdbCache {
  id            Int       @id @default(autoincrement())
  cacheKey      String    @unique
  data          String    // JSON stringified
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model PluginState {
  id              Int       @id @default(autoincrement())
  pluginId        String    @unique
  enabled         Boolean   @default(true)
  settings        String    @default("{}") // JSON blob for plugin-specific settings
  onInstallRan    Boolean   @default(false)
  // Latest release version as observed by the update checker — null if the plugin
  // isn't in the registry or no check has run yet. Updated by GET /plugins/updates.
  latestVersion   String?
  lastUpdateCheck DateTime?
  // 'registry' | 'local'. Set at install: 'registry' when /install received a repository,
  // 'local' otherwise (URL install, manual drop-in, or any pre-existing PluginState row).
  installSource   String    @default("local")
  // GitHub repository ("<owner>/<repo>") for registry installs. Used by the update checker
  // and the future auto-update job to look up releases without re-deriving from the plugin id
  // (which can be the legacy short form for ids that predate the new format).
  repository      String?
  autoUpdateEnabled    Boolean   @default(false)
  lastUpdateAttemptAt  DateTime?
  // 'success' | 'failed' | 'rolled-back'
  lastUpdateStatus     String?
  lastUpdateError      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UserNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // "request_approved" | "request_declined" | "media_available" | "plugin:xxx"
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  String?  // JSON (mediaId, requestId, tmdbId, etc.)
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Keyword {
  id        Int      @id @default(autoincrement())
  tmdbId    Int      @unique
  name      String
  tag       String?  // "nsfw", "anime", or any custom tag
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patchnote {
  id      Int      @id @default(autoincrement())
  version String   @unique
  type    String   // "major" | "minor" | "patch"
  date    DateTime
  titleEn String
  titleFr String
  entries String   // JSON: [{ type: "feat"|"fix"|"perf", titleEn, titleFr, descEn?, descFr? }]
  bodyEn  String?
  bodyFr  String?
}

model ShareLink {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  tmdbId    Int
  mediaType String   // "movie" | "tv"
  title     String?  // snapshot for the "my links" list (no extra fetch)
  posterPath String?
  views     Int      @default(0)
  createdById Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int
  endpoint   String    @unique
  p256dh     String
  auth       String
  // Stable id kept in the browser (localStorage). A subscription replaced by the same browser
  // carries the same id, so the old endpoint can be removed instead of pushing twice.
  deviceId   String?
  userAgent  String?
  // Last time the device opened the app (or re-registered). Older rows are stale candidates.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PluginLog {
  id        Int      @id @default(autoincrement())
  pluginId  String
  level     String   // "info" | "warn" | "error" | "debug"
  message   String
  createdAt DateTime @default(now())

  @@index([pluginId, createdAt])
}

// Status-to-category mapping lives in each connector (resolveState), not in the DB.

// Admin → Lists: a list link (or `custom:<id>`) that keeps feeding Radarr/Sonarr. Ported from
// media-heal's list subscriptions; JSON columns keep the same shapes so its state imports as-is.
model ListSubscription {
  id            Int       @id @default(autoincrement())
  url           String    @unique // canonical list link, or custom:<id>
  name          String?
  provider      String    @default("")
  mediaType     String    @default("mixed") // movie | show | mixed
  enabled       Boolean   @default(true)
  settings      String    @default("{}") // { search, onlyNew, radarrProfileId, radarrRoot, sonarrProfileId, sonarrRoot }
  seenKeys      String    @default("[]")
  lastNew       String    @default("[]")
  history       String    @default("[]")
  lastResult    String?
  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A handmade list: titles picked by hand, fed to Radarr/Sonarr like any other list.
model CustomList {
  id        String   @id
  name      String
  items     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A user-reported problem with a title they already have ("wrong file", "audio missing"…).
/// Admins triage these from Admin → Issues; nothing is changed automatically.
model MediaIssue {
  id           Int       @id @default(autoincrement())
  mediaId      Int?
  tmdbId       Int
  mediaType    String
  title        String
  userId       Int
  category     String    @default("other") // playback | wrong_file | audio | subtitles | other
  message      String
  status       String    @default("open")  // open | resolved
  adminNote    String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById Int?

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("MediaIssueResolvedBy", fields: [resolvedById], references: [id])
  media      Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([mediaId])
  @@index([userId])
}
